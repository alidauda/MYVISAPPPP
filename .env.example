# ---------------------------------------------------------------------------
# Leave VITE_API_ORIGIN unset to run against the mock handlers in src/mocks.
# That is the default, and needs no backend at all.
#
# Set it to a running backend and the dev server proxies /api/v1 there instead
# — the browser still makes a same-origin request, so CORS never comes into it.
#
#   VITE_API_ORIGIN=http://localhost:8080
#
# In a production build there is no dev server, so this value is baked into the
# bundle as an absolute URL and the backend must allow the site's origin.
# ---------------------------------------------------------------------------
# VITE_API_ORIGIN=http://localhost:8080
VITE_API_PREFIX=/api/v1
